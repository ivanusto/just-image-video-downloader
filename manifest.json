{
  "manifest_version": 3,
  "name": "Just Image & Video Downloader",
  "version": "4.0",
  "description": "One-click image & video downloader with original quality, batch download, duplicate protection, and custom filenames.",
  "icons": {
    "48": "icons/icon48.png",
    "96": "icons/icon96.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "48": "icons/icon48.png",
      "96": "icons/icon96.png"
    },
    "default_popup": "src/popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.instagram.com/*",
        "*://*.threads.net/*",
        "*://*.threads.com/*"
      ],
      "js": [
        "src/content.js"
      ],
      "css": [
        "src/styles.css"
      ],
      "run_at": "document_end"
    }
  ],
  "permissions": [
    "downloads",
    "webRequest",
    "alarms",
    "storage"
  ],
  "host_permissions": [
    "*://*.instagram.com/*",
    "*://*.threads.net/*",
    "*://*.threads.com/*",
    "*://*.cdninstagram.com/*",
    "*://*.fbcdn.net/*"
  ]
}
