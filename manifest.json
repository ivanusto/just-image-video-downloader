{
  "manifest_version": 3,
  "name": "Just IG Image & Video Downloader",
  "version": "2.8",
  "description": "Download Instagram images and videos with a simple click. Support photos, videos, reels and stories",
  "icons": {
    "48": "icons/icon48.png",
    "96": "icons/icon96.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "48": "icons/icon48.png",
      "96": "icons/icon96.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.instagram.com/*"
      ],
      "js": [
        "src/content.js"
      ],
      "css": [
        "src/styles.css"
      ]
    }
  ],
  "permissions": [
    "downloads",
    "webRequest",
    "alarms",
    "storage",
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "*://*.instagram.com/*",
    "*://*.cdninstagram.com/*",
    "*://*.fbcdn.net/*"
  ]
}
